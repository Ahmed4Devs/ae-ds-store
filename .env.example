# ==========================================================================
#  ae-ds-store — متغيّرات البيئة
#  انسخ هذا الملف إلى .env وضع قيمك الحقيقية
# ==========================================================================

# --- قاعدة البيانات (PostgreSQL) ---------------------------------------
# في التطوير فقط يمكن أن يكون الرابطان للدور المحلي نفسه. في الإنتاج اجعل
# DATABASE_URL لدور تشغيل محدود وMIGRATION_DATABASE_URL لدور DDL منفصل لا
# يُحقن في حاوية التطبيق. لا تستخدم postgres/superuser وقت التشغيل.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ae_ds_store?schema=public"
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ae_ds_store?schema=public"
# حد الاتصالات لكل نسخة تطبيق (1–20). احسبه مع عدد نسخ serverless.
DB_POOL_MAX="5"

# --- المصادقة (better-auth) --------------------------------------------
# ولّد مفتاحًا عشوائيًا حقيقيًا (≥32 محرفًا؛ 48+ في الإنتاج): openssl rand -base64 48
# خزّنه في مدير أسرار؛ تدويره يبطل كل الجلسات الحالية ويتطلب دخولًا جديدًا.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# اختياري في التطوير، لكنه يجب أن يكون true في الإنتاج. يفرضه الخادم أيضًا
# دفاعًا إضافيًا، ويتطلب مُرسِل smtp أو resend صالحًا.
AUTH_REQUIRE_EMAIL_VERIFICATION="false"

# عناوين البروكسي العكسي الموثوقة (مفصولة بفواصل) لاستخلاص IP العميل من
# X-Forwarded-For. يجوز فراغها في التطوير وعلى Vercel فقط (يُستخدم هناك
# x-vercel-forwarded-for)؛ خارج Vercel يرفضها الإنتاج فارغة. اضبط CIDR
# الفعلي للبروكسي واجعله يستبدل الترويسة ويمنع الوصول إلى الأصل.
TRUSTED_PROXIES=""

# --- بذر التطوير والتحقق المعزول ---------------------------------------
# لا تحفظ قيمًا فعلية في هذا الملف. البذر يتطلب NODE_ENV=development،
# وأن يساوي SEED_CONFIRM الصيغة seed:<host>:<port>:<database>:<schema>،
# وكلمتَي مرور مختلفتين طول كل منهما 20–128 محرفًا.
SEED_CONFIRM=""
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_CUSTOMER_NAME=""
SEED_CUSTOMER_EMAIL=""
SEED_CUSTOMER_PASSWORD=""

# لا يُقبل verify:auth إلا مع NODE_ENV=test وقاعدة/مخطط يحمل كلمة test.
AUTH_VERIFY_TEST_DB="false"

# --- تكامل AliExpress ---------------------------------------------------
# mock = بيانات وهمية مطابقة لبنية التوثيق (لا حاجة لمفاتيح)
# live = استدعاء الواجهات الحقيقية (يتطلب المفاتيح أدناه)
AE_MODE="mock"

# نقطة النهاية الموحّدة كما ينص التوثيق الرسمي
AE_API_BASE_URL="https://api-sg.aliexpress.com/rest"

# تُصدرهما لوحة تحكم AliExpress عند إنشاء التطبيق
AE_APP_KEY="000000"
AE_APP_SECRET="00000000000000000000000000000000"

# رمز الوصول الصادر عن حساب المشتري المفوَّض كحساب دروبشيبينغ
AE_ACCESS_TOKEN=""
AE_REFRESH_TOKEN=""
# مفتاح AES-256 لتشفير الرمزين داخل PostgreSQL؛ مطلوب في AE_MODE=live.
# ولّده مرة واحدة واحفظه في مدير أسرار: openssl rand -base64 32
AE_TOKEN_ENCRYPTION_KEY=""

# --- إعدادات السوق السعودي ----------------------------------------------
# الريال السعودي غير مدعوم في واجهات AliExpress إطلاقًا،
# لذا نجلب بالدولار ونحوّل محليًا.
AE_SOURCE_CURRENCY="USD"
STORE_CURRENCY="SAR"
STORE_COUNTRY="SA"
STORE_LOCALE="ar_SA"

# فيديو اختياري للشريحة الأولى في Hero. ضع الملف داخل public مثل
# public/media/hero.mp4 ثم استخدم المسار العام أدناه. يعمل تلقائيًا بصمت وloop.
HERO_VIDEO_PATH=""

# سعر صرف الدولار مقابل الريال (الريال مربوط بـ 3.75)
FX_USD_TO_SAR="3.75"
# هامش احتياطي لتقلّب الصرف ورسوم التحويل (نسبة مئوية)
FX_BUFFER_PERCENT="2"

# --- التسعير ------------------------------------------------------------
# هامش الربح الافتراضي (نسبة مئوية تُضاف على التكلفة)
DEFAULT_MARGIN_PERCENT="35"
# ضريبة القيمة المضافة في السعودية
VAT_PERCENT="15"
# التقريب النهائي للسعر (0.05 = أقرب 5 هللات)
PRICE_ROUNDING="0.05"

# --- تفويض AliExpress في وقت التشغيل ------------------------------------
# الرمزان أعلاه بذرة أولى فقط: تُستورد مرة واحدة إلى جدول AeToken، ثم
# يجدّد النظام رمز الوصول تلقائيًا ويخزّنه هناك — لأن متغيّر البيئة يُقرأ
# عند الإقلاع ولا يستطيع الخادم تحديثه لنفسه.
AE_TOKEN_REFRESH_SKEW_SECONDS="300"
# حذف سجلات واجهة AliExpress الأقدم من هذه المدة بواسطة المهمة الدورية.
AE_API_LOG_RETENTION_DAYS="30"
# إذا ارتفعت تكلفة المنتج + الشحن بعد الدفع بأكثر من هذه النسبة، يوقف
# التوريد ويفتح مراجعة بدل الشراء بخسارة غير محدودة.
AE_MAX_SOURCE_COST_INCREASE_PERCENT="3"

# يطلب الخصم فور إنشاء الطلبية (try_to_pay). لا تفعّله قبل تفويض الحساب
# كحساب دروبشيبينغ — ينص التوثيق على أن ذلك يُفشل الطلبية.
AE_TRY_TO_PAY="false"

# --- الدفع ---------------------------------------------------------------
# manual  = نيّة دفع حقيقية يؤكّدها المسؤول (تطوير، وتحويل بنكي)
# moyasar = بوابة Moyasar السعودية (مدى + بطاقات)
# tap     = بوابة Tap
PAYMENT_PROVIDER="manual"
MOYASAR_SECRET_KEY=""
MOYASAR_PUBLISHABLE_KEY=""
TAP_SECRET_KEY=""
# سرّ مشترك للتحقق من توقيع إشعارات المزوّد
PAYMENT_WEBHOOK_SECRET=""
# مهلة نيّة الدفع بالدقائق
PAYMENT_EXPIRY_MINUTES="30"

# --- البريد --------------------------------------------------------------
# console = يطبع الرسالة في السجل (تطوير فقط)
# smtp    = إرسال فعلي عبر SMTP_URL
# resend  = إرسال فعلي عبر واجهة Resend
MAIL_PROVIDER="console"
MAIL_FROM="no-reply@ae-ds-store.local"
MAIL_FROM_NAME=""
SMTP_URL=""
RESEND_API_KEY=""

# --- المهام المجدولة -----------------------------------------------------
# سرّ يحمي /api/cron/sync-orders. يجوز تركه فارغًا في التطوير فقط؛ هو
# إلزامي في الإنتاج لأن المسار يستدرك التوريد والاسترداد بعد سقوط أي نسخة.
# ولّده بـ: openssl rand -hex 32
# ثم استدعِ المسار كل عشر دقائق:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://example.com/api/cron/sync-orders
CRON_SECRET=""

# --- بيانات المنشأة (الفاتورة الضريبية ورمز ZATCA) ------------------------
STORE_LEGAL_NAME="متجر الوصل"
# الرقم الضريبي: خمس عشرة خانة. مطلوب لإصدار فاتورة ضريبية صحيحة.
STORE_VAT_NUMBER=""
STORE_CR_NUMBER=""
# العنوان العام — يُستخدم في sitemap.xml و robots.txt وروابط البريد
STORE_PUBLIC_URL="http://localhost:3000"
