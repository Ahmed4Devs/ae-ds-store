# ==========================================================================
#  ae-ds-store — متغيّرات البيئة
#  انسخ هذا الملف إلى .env وضع قيمك الحقيقية
# ==========================================================================

# --- قاعدة البيانات (PostgreSQL) ---------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ae_ds_store?schema=public"

# --- المصادقة (better-auth) --------------------------------------------
# ولّد مفتاحًا عشوائيًا: openssl rand -base64 32
BETTER_AUTH_SECRET="dev-secret-change-me-in-production-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# --- تكامل AliExpress ---------------------------------------------------
# mock = بيانات وهمية مطابقة لبنية التوثيق (لا حاجة لمفاتيح)
# live = استدعاء الواجهات الحقيقية (يتطلب المفاتيح أدناه)
AE_MODE="mock"

# نقطة النهاية الموحّدة كما ينص التوثيق الرسمي
AE_API_BASE_URL="https://api-sg.aliexpress.com/rest"

# تُصدرهما لوحة تحكم AliExpress عند إنشاء التطبيق
AE_APP_KEY="000000"
AE_APP_SECRET="00000000000000000000000000000000"

# رمز الوصول الصادر عن حساب المشتري المفوَّض كحساب دروبشيبينغ
AE_ACCESS_TOKEN=""
AE_REFRESH_TOKEN=""

# --- إعدادات السوق السعودي ----------------------------------------------
# الريال السعودي غير مدعوم في واجهات AliExpress إطلاقًا،
# لذا نجلب بالدولار ونحوّل محليًا.
AE_SOURCE_CURRENCY="USD"
STORE_CURRENCY="SAR"
STORE_COUNTRY="SA"
STORE_LOCALE="ar_SA"

# سعر صرف الدولار مقابل الريال (الريال مربوط بـ 3.75)
FX_USD_TO_SAR="3.75"
# هامش احتياطي لتقلّب الصرف ورسوم التحويل (نسبة مئوية)
FX_BUFFER_PERCENT="2"

# --- التسعير ------------------------------------------------------------
# هامش الربح الافتراضي (نسبة مئوية تُضاف على التكلفة)
DEFAULT_MARGIN_PERCENT="35"
# ضريبة القيمة المضافة في السعودية
VAT_PERCENT="15"
# التقريب النهائي للسعر (0.05 = أقرب 5 هللات)
PRICE_ROUNDING="0.05"
